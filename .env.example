# Copy to .env.local for `npm run dev`. In production these live in
# Vercel → Project → Settings → Environment Variables.

# Long-lived Instagram token (Meta App Dashboard → Instagram → API setup → Generate token)
INSTAGRAM_ACCESS_TOKEN=

# Any random string ≥16 chars; Vercel sends it to the cron job automatically
CRON_SECRET=

# Added automatically when you connect Upstash Redis under Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only for a frontend hosted somewhere else (e.g. Netlify) that should call the
# Vercel API: VITE_API_BASE_URL=https://your-site.vercel.app
VITE_API_BASE_URL=
